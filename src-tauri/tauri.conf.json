{
  "build": {
    "distDir": "../web",
    "devPath": "../web",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "package": {
    "productName": "SYMB-MIR",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": false,
        "setAlwaysOnTop": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "ai.symbeyond.symb-mir",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "SYMB-MIR",
        "url": "symb-mir-popout.html",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
